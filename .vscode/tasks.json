{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run",
      "type": "shell",
      "command": "gm-cli",
      "args": ["run", "gems.yyp"],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Compile",
      "type": "shell",
      "command": "gm-cli",
      "args": ["compile", "gems.yyp"],
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Open Working Directory",
      "detail": "Open the save dir (%LOCALAPPDATA%\\gems\\) in File Explorer — holds game.log, save.json, settings.json, debug.txt.",
      "type": "shell",
      "command": "explorer",
      "args": ["${env:LOCALAPPDATA}\\gems"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "close": true
      }
    }
  ]
}
